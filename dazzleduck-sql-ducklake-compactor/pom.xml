<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.dazzleduck.sql</groupId>
        <artifactId>dazzleduck-parent</artifactId>
        <version>0.2.22-SNAPSHOT</version>
    </parent>

    <artifactId>dazzleduck-sql-ducklake-compactor</artifactId>
    <name>DazzleDuck DuckLake Compaction Service</name>
    <description>Compaction service that merges small DuckLake data files into larger ones.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>io.dazzleduck.sql.compaction.Main</exec.mainClass>
        <!-- Pinned pair: instrumentation 2.16.0-alpha targets OpenTelemetry API 1.50.0. -->
        <otel.version>1.50.0</otel.version>
        <otel.instrumentation.version>2.16.0-alpha</otel.instrumentation.version>
        <logback.version>1.5.15</logback.version>
        <!-- DuckDB native lib to bundle in the native image (amd64|arm64). Override per target arch:
             the Dockerfile passes -Dduckdb.native.arch=$TARGETARCH. -->
        <duckdb.native.arch>arm64</duckdb.native.arch>
        <!-- Override with -Djib.architecture=arm64 on Apple Silicon -->
        <jib.architecture>amd64</jib.architecture>
        <testcontainer.version>1.21.2</testcontainer.version>
        <excluded.test.groups>stress</excluded.test.groups>

        <!-- Patched DuckLake extension (backports duckdb/ducklake#1453: concurrent compactions on
             disjoint files in the same table falsely conflict) onto d8a1881e, the commit the
             parent pom's duckdb.version pins via duckdb/duckdb's own ducklake.cmake. Built and
             published by dazzleduck-web/ducklake's build-and-publish-extension.yml workflow. See
             DUCKLAKE_PATCH.md for how these three properties relate and how to update them.
             ducklake.patch.built.for.duckdb.version MUST equal the parent pom's duckdb.version,
             enforced by DuckLakePatchVersionTest. -->
        <ducklake.patch.release>v1.5.5-dazzleduck.2</ducklake.patch.release>
        <ducklake.patch.built.for.duckdb.version>1.5.5.1</ducklake.patch.built.for.duckdb.version>
        <!-- The DuckDB library-version string (not duckdb.version) DuckDB uses to name its
             extension cache directory, e.g. ~/.duckdb/extensions/v1.5.5/linux_amd64/. Verified via
             `select * from pragma_version()` against duckdb_jdbc:${duckdb.version}. -->
        <ducklake.extension.cache.version>v1.5.5</ducklake.extension.cache.version>
        <!-- See the exec-maven-plugin execution below: false only for the specific commands that
             build this module's jib image. -->
        <ducklake.extension.download.skip>true</ducklake.extension.download.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${otel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ConnectionPool + CommandLineConfigUtil; brings dazzleduck-sql-common transitively. -->
        <dependency>
            <groupId>io.dazzleduck.sql</groupId>
            <artifactId>dazzleduck-sql-commons</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- StartupScriptProvider. Declared even though commons pulls it in, because this module
             imports it directly and a transitive path is not a contract. -->
        <dependency>
            <groupId>io.dazzleduck.sql</groupId>
            <artifactId>dazzleduck-sql-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>1.12.7</version>
        </dependency>

        <!-- SLF4J logging backend. Without a provider on the runtime classpath SLF4J falls back to a
             NOP logger, so the service logs nothing (in the jar image and the native image alike). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- OTLP metric export to the collector's gRPC receiver. The gRPC framing comes from the
             OkHttp sender pulled in by exporter-otlp, so no grpc-java dependency is needed. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Bridges the existing Micrometer meters onto OpenTelemetry instruments, so
             CompactionState keeps using Micrometer. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-micrometer-1.5</artifactId>
            <version>${otel.instrumentation.version}</version>
        </dependency>
        <!-- Ships SLF4J/Logback events to the collector as OTLP log records. Attached to the root
             logger in code (no logback.xml), so a disabled exporter leaves logging untouched. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${otel.instrumentation.version}</version>
        </dependency>

        <!-- Real Postgres for the raw-connection concurrent-tiers integration test — file-based
             DuckLake catalogs can't support it (only one attach at a time; see RawConnections). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainer.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainer.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Only ducklake-patch-version.properties is filtered (it exists purely to smuggle pom
             properties into a test); everything else in src/test/resources stays literal, since
             application.conf-style ${?ENV_VAR} HOCON syntax elsewhere must not be touched by Maven's
             resource filtering. -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>src/test/resources-filtered</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- CompactionStressTest runs for a minute; run it with -Pstress -->
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                    <argLine>${arrow.jvm.flags}</argLine>
                </configuration>
            </plugin>

            <!-- Fat JAR for standalone execution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>
                                <!-- The OTLP exporter resolves its gRPC sender through
                                     ServiceLoader; without merging META-INF/services the shaded
                                     jar starts and then fails on the first export. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Downloads the patched DuckLake extension for the arch being built (jib.architecture)
                 from the dazzleduck-web/ducklake release, before jib packages it below. Mirrors
                 Dockerfile.native's curl step for the same binary; see DUCKLAKE_PATCH.md.

                 Skipped by default (ducklake.extension.download.skip=true): this execution is bound
                 to generate-resources purely to sequence ahead of the explicit `jib:build`/
                 `jib:dockerBuild` goal invocation (which isn't itself phase-bound in this repo's
                 build commands), but generate-resources is also part of `mvn test`/`install`/
                 `verify` and the native profile's own `package`, none of which need this 36MB
                 asset. Callers that actually build this module's jib image must pass
                 -Dducklake.extension.download.skip=false (see release.yml, scripts/docker-publish.sh,
                 this module's README, .claude/commands/publish-docker.md). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>download-patched-ducklake-extension</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${ducklake.extension.download.skip}</skip>
                            <executable>curl</executable>
                            <arguments>
                                <argument>-fsSL</argument>
                                <argument>--create-dirs</argument>
                                <argument>-o</argument>
                                <argument>${project.build.directory}/ducklake-extension/linux_${jib.architecture}/ducklake.duckdb_extension</argument>
                                <argument>https://github.com/dazzleduck-web/ducklake/releases/download/${ducklake.patch.release}/ducklake-linux_${jib.architecture}.duckdb_extension</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Docker image -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <from>
                        <image>dazzleduck/base-jre:${java.runtime.version}-noble-duckdb-${duckdb.version}</image>
                        <platforms>
                            <platform>
                                <os>linux</os>
                                <architecture>${jib.architecture}</architecture>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>dazzleduck/ducklake-compactor:${project.version}-${jib.architecture}</image>
                        <tags>
                            <tag>latest-${jib.architecture}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>${exec.mainClass}</mainClass>
                        <jvmFlags>
                            <jvmFlag>--add-opens=java.base/java.nio=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--enable-native-access=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--sun-misc-unsafe-memory-access=allow</jvmFlag>
                        </jvmFlags>
                    </container>
                    <!-- Bakes the just-downloaded patched extension into the exact local cache path
                         DuckDB resolves LOAD from, so the compactor's startup script's `LOAD ducklake`
                         finds it with no network access. RawConnections and duckdb.properties set
                         allow_unsigned_extensions=true, since this build isn't signed with DuckDB
                         Labs' key. Scoped to this arch's own subdirectory, not the whole
                         ducklake-extension/ tree, so a target/ left over from building the other
                         architecture first (e.g. release.yml's amd64-then-arm64 loop, no `clean`
                         between them) doesn't bake an unused ~36MB binary into this image too. -->
                    <extraDirectories>
                        <paths>
                            <path>
                                <from>${project.build.directory}/ducklake-extension/linux_${jib.architecture}</from>
                                <into>/root/.duckdb/extensions/${ducklake.extension.cache.version}/linux_${jib.architecture}</into>
                            </path>
                        </paths>
                    </extraDirectories>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native image. Build with a GraalVM JDK 21 (native-image on PATH):
            ./mvnw -Pnative -pl dazzleduck-sql-ducklake-compactor -am -DskipTests package
          produces target/compactor. Reachability metadata (reflection/JNI/resources, incl. the
          bundled DuckDB .so) lives in src/main/resources/META-INF/native-image and is picked up
          automatically. The metadata is captured on linux/arm64; an amd64 build needs its own
          capture of the amd64 DuckDB .so.
        -->
        <!-- Runs only CompactionStressTest:
            ./mvnw test -Pstress -pl dazzleduck-sql-ducklake-compactor
          Tune it with -Dcompaction.stress.duration=PT5M, -Dcompaction.stress.writers, -Dcompaction.stress.seed,
          and -Dducklake.extension.path to test a patched DuckLake build. -->
        <profile>
            <id>stress</id>
            <properties>
                <excluded.test.groups/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>stress</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>compactor</imageName>
                            <mainClass>${exec.mainClass}</mainClass>
                            <!--
                              Use only the metadata captured for this project's exact dependency
                              versions. The shipped GraalVM reachability-metadata repo carries entries
                              for older versions and one registers a JNI method that fails to link
                              (ScopedMemoryAccess.closeScope0).
                            -->
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- Logback/SLF4J must be initialized at build time or the build aborts. -->
                                <buildArg>--initialize-at-build-time=org.slf4j,ch.qos.logback</buildArg>
                                <buildArg>--initialize-at-run-time=io.netty</buildArg>
                                <!-- Bundle only the target-arch DuckDB .so (the jar ships all of them).
                                     Kept out of resource-config so one metadata set serves both arches. -->
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:IncludeResources=libduckdb_java\.so_linux_${duckdb.native.arch}</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
