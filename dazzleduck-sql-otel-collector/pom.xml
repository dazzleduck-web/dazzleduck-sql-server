<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.dazzleduck.sql</groupId>
        <artifactId>dazzleduck-parent</artifactId>
        <version>0.2.22-SNAPSHOT</version>
    </parent>

    <artifactId>dazzleduck-sql-otel-collector</artifactId>
    <name>DazzleDuck OpenTelemetry Collector</name>
    <description>OpenTelemetry collector that ingests traces, metrics, and logs into DuckDB and DuckLake.</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j.version>2.0.16</slf4j.version>
        <typesafe.config.version>1.4.4</typesafe.config.version>
        <jcommander.version>2.0</jcommander.version>
        <logback.version>1.5.15</logback.version>
        <surefire.version>3.5.2</surefire.version>
        <grpc.version>1.68.0</grpc.version>
        <otel.proto.version>1.3.2-alpha</otel.proto.version>
        <exec.mainClass>io.dazzleduck.sql.otel.collector.Main</exec.mainClass>
        <!-- Override with -Djib.architecture=arm64 on Apple Silicon -->
        <jib.architecture>amd64</jib.architecture>
        <!-- DuckDB native lib to bundle in the native image (amd64|arm64). The Dockerfile passes
             -Dduckdb.native.arch=$TARGETARCH; defaults to arm64 for a bare local build. -->
        <duckdb.native.arch>arm64</duckdb.native.arch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- OpenTelemetry proto (includes gRPC stubs for LogsService) -->
        <dependency>
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
            <version>${otel.proto.version}</version>
        </dependency>

        <!-- gRPC server runtime -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <!-- Annotation API needed by gRPC generated stubs on Java 9+ -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <!-- Apache Arrow -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- DuckDB and commons (for ConnectionPool.bulkIngestToFile) -->
        <dependency>
            <groupId>io.dazzleduck.sql</groupId>
            <artifactId>dazzleduck-sql-commons</artifactId>
            <version>0.2.22-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.dazzleduck.sql</groupId>
            <artifactId>dazzleduck-sql-common</artifactId>
            <version>0.2.22-SNAPSHOT</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- HOCON Configuration -->
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>${typesafe.config.version}</version>
        </dependency>

        <!-- CLI argument parsing -->
        <dependency>
            <groupId>org.jcommander</groupId>
            <artifactId>jcommander</artifactId>
            <version>${jcommander.version}</version>
        </dependency>

        <!-- Micrometer metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>1.12.7</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>${arrow.jvm.flags}</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Docker image -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <from>
                        <image>dazzleduck/base-jre:${java.runtime.version}-noble-duckdb-${duckdb.version}</image>
                        <platforms>
                            <platform>
                                <os>linux</os>
                                <architecture>${jib.architecture}</architecture>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>dazzleduck/dazzleduck-otel-collector:${project.version}-${jib.architecture}</image>
                        <tags>
                            <tag>latest-${jib.architecture}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>${exec.mainClass}</mainClass>
                        <!-- Declared here (previously inherited from the parent pom's Jib block, now removed).
                             Arrow/Netty on JDK 25 need the last two. -->
                        <jvmFlags>
                            <jvmFlag>-Xms512m</jvmFlag>
                            <jvmFlag>-XX:+UseContainerSupport</jvmFlag>
                            <jvmFlag>-XX:+UseG1GC</jvmFlag>
                            <jvmFlag>-XX:+UseStringDeduplication</jvmFlag>
                            <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                            <jvmFlag>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--add-opens=java.base/java.nio=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--add-opens=java.base/sun.util.calendar=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--enable-native-access=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>--sun-misc-unsafe-memory-access=allow</jvmFlag>
                        </jvmFlags>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          GraalVM native image. Build with a GraalVM JDK 21 (native-image on PATH):
            ./mvnw -Pnative -pl dazzleduck-sql-otel-collector -am -DskipTests package
          produces target/collector. Reachability metadata (reflection/JNI/resources, incl. the
          bundled DuckDB .so) lives in src/main/resources/META-INF/native-image and is picked up
          automatically. The metadata is captured on linux/arm64; an amd64 build needs its own
          capture of the amd64 DuckDB .so.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>collector</imageName>
                            <mainClass>${exec.mainClass}</mainClass>
                            <!--
                              Use only the metadata captured for this project's exact dependency
                              versions (src/main/resources/META-INF/native-image). The shipped
                              GraalVM reachability-metadata repo carries entries for OLDER versions
                              (netty 4.1.80 vs 4.2.9, jackson 2.15 vs 2.21, logback 1.4.9 vs 1.5.15)
                              and one of them registers a JNI method that fails to link
                              (ScopedMemoryAccess.closeScope0).
                            -->
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <!-- Logback/SLF4J must be initialized at build time or the build aborts. -->
                                <buildArg>--initialize-at-build-time=org.slf4j,ch.qos.logback</buildArg>
                                <buildArg>--initialize-at-run-time=io.netty</buildArg>
                                <!-- Bundle only the target-arch DuckDB .so (the jar ships all of them).
                                     Kept out of resource-config so one metadata set serves both arches. -->
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:IncludeResources=libduckdb_java\.so_linux_${duckdb.native.arch}</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
